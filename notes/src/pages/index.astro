---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = await getCollection('notes');
const sorted = notes.sort((a, b) => b.data.id.localeCompare(a.data.id));
---

<BaseLayout title="Wiki | wiki.hellointernet.lol">
  <div class="index cg-stack">
    <header class="intro cg-panel">
      <h1>Notes</h1>
      <p>Working notes, not a blog. Logged when useful.</p>
    </header>

    <div class="list cg-list">
      {sorted.map((note) => (
        <a class="note cg-card cg-card-link" href={`/${note.slug}`}>
          <div class="meta cg-meta">
            <span class="id">{note.data.id}</span>
            <span class="title">{note.data.title}</span>
            {note.data.status !== 'published' && (
              <span class:list={['cg-status', note.data.status]}>{note.data.status}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .index,
  .note {
    max-width: 820px;
  }

  .title {
    font-weight: 600;
  }

  .body {
    margin-top: 1.25rem;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--cg-text-2);
  }
</style>
