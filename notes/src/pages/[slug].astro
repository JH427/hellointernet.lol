---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
---

<BaseLayout title={`${note.data.title} | wiki.hellointernet.lol`}>
  <article class="note cg-text-slab">
    <div class="meta cg-meta">
      <span class="id">{note.data.id}</span>
      {note.data.status !== 'published' && (
        <span class:list={['cg-status', note.data.status]}>{note.data.status}</span>
      )}
      {note.data.updated && <span class="updated">updated {note.data.updated}</span>}
    </div>

    <h1 class="title">{note.data.title}</h1>

    <div class="body">
      <Content />
    </div>

    <p class="back"><a href="/">← back to notes</a></p>
  </article>
</BaseLayout>

<style>
  .index,
  .note {
    max-width: 820px;
  }

  .title {
    font-weight: 600;
  }

  .body {
    margin-top: 1.25rem;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--cg-text-2);
  }
</style>
