---
const projects = [
{ name:'Horizon Code', repo:'horizon-code', kind:'01 / Local AI', status:'Implemented foundation · experimental routing', title:'An agent loop with a verification gate.', description:'A Go coding harness for llama.cpp: typed tools, bounded execution, persistent evidence, and a terminal UI. Workspace changes require a passing verification command before completion.', caveat:'Decision routing is opt-in and experimental—not a demonstrated across-the-board improvement.', evidence:'internal/tools + deterministic integration tests', path:'tree/main/internal', graphic:'horizon' },
{ name:'Sloperator', repo:'sloperator', kind:'02 / Machine-made media', status:'Early alpha · CPU-safe foundation', title:'Treat the timeline as a contract.', description:'A CLI for frozen show manifests, input hashes, resource preflight, and CPU-only ffmpeg montage assembly. Canonical audio stays intact while picture gets stitched and validated.', caveat:'GPU generation is roadmap work, not a shipped capability. The run command plans; it does not render.', evidence:'Show schema + architecture + test suite', path:'blob/main/docs/ARCHITECTURE.md', graphic:'timeline' },
{ name:'FAE PDF', repo:'fae-pdf', kind:'03 / Useful glue', status:'Small standalone toolkit', title:'Structured content in. A document out.', description:'A stateless Python CLI that pairs Jinja2 HTML templates with Playwright’s Chromium PDF printing. File or inline JSON input, A4 output, no server.', caveat:'A rendering tool, not a hosted document service. Templates and content are supplied by the caller.', evidence:'Rendering implementation + CLI', path:'blob/main/render.py', graphic:'document' }
];
---
<div class="selected-work">{projects.map(p => <article class={`project project-${p.graphic}`}>
<figure><div class="artifact-drawing" aria-hidden="true">
{p.graphic === 'horizon' ? <svg viewBox="0 0 440 260"><path class="grid-lines" d="M0 65H440M0 130H440M0 195H440M110 0V260M220 0V260M330 0V260"/><rect x="37" y="38" width="366" height="184" rx="5"/><path d="M37 68H403M285 68V222"/><circle cx="53" cy="53" r="3"/><circle cx="66" cy="53" r="3"/><circle cx="79" cy="53" r="3"/><path class="accent" d="M60 101L70 108L60 115M84 115H190M60 143H240M60 154H213M60 165H228M60 190H170M305 99H379M305 114H360M305 153H379M305 168H349"/><text x="306" y="202">VERIFY →</text></svg> : p.graphic === 'timeline' ? <svg viewBox="0 0 440 260"><path class="grid-lines" d="M40 30V230M100 30V230M160 30V230M220 30V230M280 30V230M340 30V230M400 30V230"/><text x="40" y="44">PICTURE / FRAME</text><rect x="40" y="66" width="110" height="45"/><rect x="158" y="66" width="142" height="45"/><rect x="308" y="66" width="92" height="45"/><text x="40" y="149">CANONICAL AUDIO / SAMPLE</text><path class="accent" d="M40 190H55L60 180L65 200L70 174L75 207L80 184L85 190H105L110 170L115 210L120 179L125 199L130 190H165L170 180L175 202L180 167L185 213L190 181L195 190H230L235 176L240 207L245 184L250 194L255 190H280L285 169L290 211L295 180L300 200L305 190H335L340 181L345 201L350 175L355 205L360 188L365 190H400"/><path d="M223 48V225"/></svg> : <svg viewBox="0 0 440 260"><path class="grid-lines" d="M0 65H440M0 130H440M0 195H440M110 0V260M220 0V260M330 0V260"/><rect x="45" y="82" width="115" height="96" rx="4"/><text x="64" y="119">{'{ JSON }'}</text><path class="accent" d="M64 139H136M64 151H116M176 130H239L230 121M239 130L230 139"/><path d="M264 34H352L390 72V228H264ZM352 34V72H390"/><path class="accent" d="M286 98H365M286 111H350M286 139H365M286 151H365M286 163H338M286 194H325"/><text x="62" y="202">+ TEMPLATE</text></svg>}
</div><figcaption>Illustration, not a screenshot</figcaption></figure>
<div class="project-copy"><p class="eyebrow">{p.kind}</p><h3><a href={`https://github.com/JH427/${p.repo}`}>{p.name} ↗</a></h3><p class="project-status">{p.status}</p><h4>{p.title}</h4><p>{p.description}</p><p class="project-caveat">{p.caveat}</p><a class="evidence-link" href={`https://github.com/JH427/${p.repo}/${p.path}`}>Inspect: {p.evidence} ↗</a></div>
</article>)}</div>
<style>
.selected-work{display:grid;gap:48px}.project{display:grid;grid-template-columns:1fr 1.2fr;gap:42px;padding-bottom:44px;border-bottom:1px solid var(--cg-border)}figure{margin:0}.artifact-drawing{background:radial-gradient(ellipse at 35% 65%,#8dab6520,transparent 70%),#171e17;border:1px solid var(--cg-border);aspect-ratio:440/280;display:grid;align-items:center}.project-timeline .artifact-drawing{background:radial-gradient(ellipse at 50% 55%,#81a9c522,transparent 70%),#151c20}.project-document .artifact-drawing{background:radial-gradient(ellipse at 60% 50%,#d3bd7d1a,transparent 70%),#1d1d17}svg{width:100%;fill:none;stroke:#84967a;stroke-width:1}svg .accent{stroke:#d5f780;stroke-width:1.6}svg .grid-lines{stroke:#94a98013}svg text{fill:#a9bd9c;stroke:none;font:10px monospace}figcaption{font:10px monospace;color:var(--cg-muted);padding-top:10px}h3{font-size:32px;margin:10px 0}h3 a{text-decoration:none;color:var(--cg-text)}h4{font-size:19px;margin:22px 0 12px;font-weight:500}.project-status{font:11px/1.5 monospace;color:var(--cg-yellow)}.project-caveat{font-size:13px;color:var(--cg-muted);border-left:2px solid var(--cg-border);padding-left:12px}.evidence-link{font-size:13px;display:inline-block;padding:8px 0}@media(max-width:750px){.project{grid-template-columns:1fr;gap:24px}.artifact-drawing{aspect-ratio:440/230}svg{max-height:230px}h3{font-size:28px}}
</style>
