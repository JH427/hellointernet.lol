---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'AI Engineer — ADP',
    period: 'Apr 2026 - Present · Remote / contract',
    bullets: [
      'Build internal AI developer tooling across Python services, governed agent workflows, and enterprise-facing TypeScript surfaces.',
      'Ship micro-frontend work in Stencil, Angular, and Nx monorepos for internal portals and AI tooling interfaces.',
      'Support MCP and agent integration workflows so developers can discover, connect, and use governed AI capabilities inside existing systems.',
      'Added Kiro CLI support to an internal skills/tooling marketplace, widening the coding-harness options available to enterprise teams.'
    ]
  },
  {
    role: 'Founder — Fully Automated Enterprises LLC',
    period: '2021 - Present · Lawrenceville, GA / Remote',
    bullets: [
      'Use FAE as an R&D studio for autonomous operations, applied AI systems, and workflow automation that actually runs.',
      'Build internal tools, orchestration patterns, and content/publication systems with LLMs, agents, Linux, Docker, and Cloudflare-secured services.',
      'Treat experiments as operating artifacts: if a system is interesting, it has to survive contact with deployment, maintenance, and revision.'
    ]
  },
  {
    role: 'Technical Analyst — High Street Consulting, LLC',
    period: '2022 - 2025 · Remote / USA',
    bullets: [
      'Served as the sole technical analyst supporting FEMA and DHS contract work across LMS administration, Microsoft 365, WordPress, and data systems.',
      'Built VBA and Python automation that cut FEMA FQS course production time by roughly 60 percent.',
      'Co-developed a CrewAI-based document generation workflow for HSEEP-compliant exercise and after-action reporting.',
      'Served as Section 508 / WCAG accessibility SME, leading QA/QC training and compliance review work.'
    ]
  },
  {
    role: 'Data / IT Systems Roles — University of Georgia',
    period: '2016 - 2022 · Athens, GA',
    bullets: [
      'Managed databases, reporting workflows, and internal tooling across research and operational environments.',
      'Automated QA/QC reporting, ISO audit preparation, and open-records support with Python, SQL, JavaScript, and scripting-heavy glue work.',
      'Supported staff through documentation, systems administration, and technical problem solving that had to work in real institutional constraints.'
    ]
  }
];

const systems = [
  {
    title: 'AI agent task orchestration API',
    detail: 'Python, FastAPI, Redis, PostgreSQL, MinIO, Docker',
    bullets: [
      'Designed queued task-processing infrastructure for AI-driven search, fetch, and automation work.',
      'Built REST endpoints for submission, status, cancellation, artifact retrieval, and deduplicated execution.'
    ]
  },
  {
    title: 'AI resume tailoring platform',
    detail: 'Next.js, TypeScript, Supabase, OpenAI, FastAPI, Stripe',
    bullets: [
      'Built a full-stack system that turns resumes into structured data and generates targeted variants with traceable history.',
      'Handled the UI, storage, rendering service, and billing workflow as one coherent product system.'
    ]
  },
  {
    title: 'Self-hosted AI development infrastructure',
    detail: 'Linux, Docker, Cloudflare Zero Trust, local + hosted LLM tooling',
    bullets: [
      'Run a self-hosted environment for building agents, internal APIs, and experimental automation systems.',
      'Use secure remote-access patterns and containerized services instead of exposing a pile of brittle public ports.'
    ]
  }
];
---

<BaseLayout title="Resume - hellointernet.lol">
  <div class="page-shell">
    <section class="cg-panel page-hero">
      <div class="cg-kicker">public resume</div>
      <h1>Joshua Harper</h1>
      <p>
        Applied AI engineer with a bias toward shipped systems: Python backends, TypeScript product work,
        agent workflows, automation infrastructure, and the glue between ideas and something that actually runs.
      </p>
      <div class="cg-meta">
        <span class="cg-status active">AI Engineer</span>
        <span class="cg-status in-progress">updated May 2026</span>
        <span>public version — contact directly for a role-specific PDF</span>
      </div>
    </section>

    <section class="page-grid tight">
      <article class="cg-card page-card">
        <div class="cg-kicker">current lane</div>
        <h2>Applied AI + full-stack product work</h2>
        <p>Strongest where APIs, UI, automation, and platform decisions all collide in one deliverable.</p>
      </article>

      <article class="cg-card page-card">
        <div class="cg-kicker">working stack</div>
        <h2>Python, TypeScript, agents</h2>
        <p>FastAPI, monorepos, Stencil/Angular, LLM integrations, MCP workflows, Linux, Docker, and pragmatic deployment glue.</p>
      </article>

      <article class="cg-card page-card">
        <div class="cg-kicker">operating style</div>
        <h2>Proof over posture</h2>
        <p>I do well in environments that value independent execution, visible artifacts, and low ceremony over dashboard theater.</p>
      </article>
    </section>

    <section class="cg-panel section-stack">
      <div>
        <div class="cg-kicker">experience</div>
        <h2 class="section-title">Recent roles</h2>
      </div>

      <div class="timeline">
        {experience.map((item) => (
          <article class="cg-card timeline-item">
            <div class="timeline-header">
              <h3>{item.role}</h3>
              <span class="timeline-period">{item.period}</span>
            </div>
            <ul class="timeline-copy">
              {item.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="page-grid">
      {systems.map((system) => (
        <article class="cg-card page-card">
          <div class="cg-kicker">selected system</div>
          <h2>{system.title}</h2>
          <p class="muted-note">{system.detail}</p>
          <ul class="detail-list">
            {system.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="page-grid tight">
      <article class="cg-card page-card">
        <div class="cg-kicker">capabilities</div>
        <h2>Core tools</h2>
        <ul class="bullet-list">
          <li>Python, FastAPI, SQL, REST APIs, PostgreSQL, Redis</li>
          <li>TypeScript, Next.js, Angular, Stencil, Nx, HTML/CSS</li>
          <li>LLM integrations, agent workflows, MCP tooling, automation design</li>
        </ul>
      </article>

      <article class="cg-card page-card">
        <div class="cg-kicker">ops + quality</div>
        <h2>Infrastructure and reliability</h2>
        <ul class="bullet-list">
          <li>Linux, Docker, lightweight deployment workflows, Cloudflare Zero Trust</li>
          <li>Accessibility / Section 508 / WCAG review and QA/QC process design</li>
          <li>Documentation, stakeholder translation, and system cleanup</li>
        </ul>
      </article>

      <article class="cg-card page-card">
        <div class="cg-kicker">education</div>
        <h2>Formal background</h2>
        <ul class="bullet-list">
          <li>A.A.S., Network and System Administration — Athens Technical College</li>
          <li>Previously held Public Trust clearance</li>
          <li>Long tail of hands-on IT, data, web, and systems work behind the current AI layer</li>
        </ul>
      </article>
    </section>

    <section class="cg-panel section-stack">
      <div>
        <div class="cg-kicker">contact</div>
        <h2 class="section-title">Need the targeted version?</h2>
        <p>For live opportunities, I can send a role-specific PDF instead of making the public page carry every possible variation.</p>
      </div>
      <div class="cg-list">
        <a class="cg-command" href="mailto:joshua@fullyautomated.enterprises">
          <span>$ contact</span>
          <span>joshua@fullyautomated.enterprises</span>
        </a>
        <a class="cg-command" href="https://github.com/JH427" target="_blank" rel="noopener noreferrer">
          <span>$ inspect</span>
          <span>github.com/JH427</span>
        </a>
        <a class="cg-command" href="https://www.linkedin.com/in/joshua-harper" target="_blank" rel="noopener noreferrer">
          <span>$ connect</span>
          <span>linkedin.com/in/joshua-harper</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
