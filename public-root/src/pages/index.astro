---
import { scene } from '../../../authoring/aperture/space.mjs';
import { REST } from '../../../authoring/aperture/model.mjs';
import '../styles/character-aperture.css';
const routes=[{name:'Work',href:'/work/',note:'Objects / projects / evidence'},{name:'Notes',href:'https://wiki.hellointernet.lol/',note:'Open notebook / external channel'},{name:'About',href:'/about/',note:'Personnel record'},{name:'Contact',href:'/contact/',note:'Establish a line back'}];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content"/><meta name="description" content="Passage. An unattended ASCII space terminal. The archive remains open."/><title>Passage — hellointernet.lol</title><link rel="icon" href="/favicon.ico"/></head>
<body><a class="skip-link" href="#main">Skip to content</a><main id="main" tabindex="-1"><h1 class="sr-only">Passage — an unattended archive</h1>
<section class="aperture" aria-label="Passage, a fictional unattended space terminal. Remote ASCII structures in deep space surround an accessible archive connection." data-motion="still" data-frame="0" data-approach="false">
<header class="terminal-mast" aria-hidden="true"><div class="office-mark">PASSAGE<span>Remote records channel</span></div><div class="terminal-assignment">DEEP FIELD / 04<span>NO OPERATOR ASSIGNED</span></div></header>
<div class="screen-rule" aria-hidden="true"><span>EXTERIOR / LONG RANGE</span><span>NO CARRIER IDENTIFIED</span></div>
<div class="character-field" aria-hidden="true"><pre class="character-art desktop-art">{scene(220,84,0,REST)}</pre><pre class="character-art mobile-art">{scene(54,70,0,REST)}</pre></div>
<div class="spatial-label" aria-hidden="true"><span>OUTER RELAY</span><span>NO RETURN SIGNAL</span></div>
<section class="console-shell" aria-label="Archive command terminal"><div class="console-header"><span>RECORDS / REMOTE</span><span class="console-warning">UNATTENDED</span></div>
<details class="site-index"><summary class="threshold" aria-label="Enter the site" title="Open directory"><span class="slit" aria-hidden="true">[ DIRECTORY ]</span><span class="enter-word">Enter</span></summary>
<div class="route-layer"><div class="route-content"><div class="route-head"><span>DIRECTORY / LOCAL ACCESS</span><button class="close-index" aria-label="Close site index" hidden>[ return ]</button></div><nav aria-label="Site index">{routes.map((r,i)=><a href={r.href}><span class="route-number" aria-hidden="true">0{i+1}</span><span>{r.name}<small>{r.note}</small></span><span class="route-arrow" aria-hidden="true">&gt;</span></a>)}</nav><div class="route-foot"><span>hellointernet.lol</span><span>04 RECORD CHANNELS</span></div></div></div>
</details>
<div class="terminal-output" tabindex="0" role="region" aria-label="Terminal output"><div class="output-intro"><p class="output-title">CONNECTION RETAINED</p><p class="warning-copy">NO OPERATOR AT THE FAR END.</p><p>The records are still here.</p><p class="command-hint">ENTER HELP OR SELECT DIRECTORY.</p><noscript><p>Command entry requires JavaScript.<br/>Directory links work without it.</p></noscript></div></div>
<form class="command-form" hidden><label for="command-input">RECORDS &gt;</label><input id="command-input" name="command" type="text" maxlength="120" autocomplete="off" autocapitalize="none" spellcheck="false" aria-label="Terminal command" aria-describedby="command-guide" placeholder="help"/><button type="submit" aria-label="Run terminal command">[ RUN ]</button></form><span id="command-guide" class="sr-only">Type help for commands. Work, notes, about and contact open site routes. Up and down arrows recall commands. Commands never execute shell code.</span>
<div class="command-shortcuts" hidden><button type="button" data-command="help">HELP</button><button type="button" data-command="inspect">INSPECT</button><button type="button" data-command="map">MAP</button><button type="button" data-command="log">LOG</button></div><p class="command-status sr-only" role="status" aria-live="polite"></p>
</section>
<footer class="terminal-footer" aria-hidden="true"><span>PASSAGE / FICTIONAL SYSTEM</span><span class="closed-channel">RECORD CHANNEL AVAILABLE</span><span class="open-channel">DIRECTORY CHANNEL OPEN</span></footer>
<button class="maker-seam" aria-label="Open site index" title="Open site index" hidden>[ DIR ]<span class="focus-label">Site index</span></button><button class="stillness" aria-label="Pause movement" aria-pressed="false" hidden>[ HOLD SPACE ]<span class="focus-label">Pause space</span></button>
</section></main><script>import '../components/character-aperture.js';</script></body></html>
