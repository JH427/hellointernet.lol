---
import {createModel,makeCodec} from '../components/multiplex-model.mjs';
import {readFileSync} from 'node:fs';
import '../styles/multiplex.css';
const codec=makeCodec(JSON.parse(readFileSync(new URL('../../public/local-glyph/vocabulary.json',import.meta.url),'utf8')));
const model=createModel();
const glyph=text=>codec.glyph(text);
const controls=[['pause','HOLD'],['spawn','ATTACH'],['ping','PING'],['interrupt','INTERRUPT'],['help','HELP']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content"/><meta name="description" content="A local fictional terminal simulation."/><title>{glyph('OTHER')}</title><link rel="icon" href="/favicon.ico"/></head>
<body><a class="skip-link" href="#operator" aria-label="Skip to operator input"><span class="glyph" aria-hidden="true">{glyph('INPUT')}</span></a>
<main id="main" class="station" data-mode="glyph" data-tick="0" data-motion="initial" aria-label="Fictional agent multiplexer">
<section id="workspace" class="workspace" data-count="4" aria-label="Tiled agent sessions">
{model.sessions.map((s,i)=><article class:list={['session',{'focused':i===0}]} data-id={s.id} data-tone={s.tone} aria-label={`${s.name}, ${s.job}`}><header class="pane-head">{i===0&&<div class="mobile-tabs" role="group" aria-label="Focus session"></div>}<button class="focus-pane" data-focus={s.id} aria-pressed={i===0} aria-label={`Focus ${s.name}, ${s.job}`}><span class="glyph pane-title" aria-hidden="true">{glyph(`${String(s.id).padStart(2,'0')} / ${s.name}`)}</span></button><span class="phase glyph" aria-hidden="true">{glyph('ATTACHED')}</span><button class="close-pane" data-close={s.id} aria-label={`Detach ${s.name}`}>×</button></header><div class="transcript" tabindex="0" aria-label={`${s.name} transcript`}>
{i===0&&<div class="specimen"><p class="glyph sigil" aria-hidden="true">{glyph('WE ARE STILL HERE')}</p><span class="semantic">WE ARE STILL HERE</span></div>}
<div class="lines">{s.lines.map(text=><div class="line"><p class="glyph" aria-hidden="true">{glyph(text)}</p><p class="semantic">{text}</p></div>)}</div></div>
{i===0&&<div id="pane-console"><div class="pane-controls">{controls.map(([id,text])=><button id={['pause','spawn'].includes(id)?id:undefined} data-command={['pause','spawn'].includes(id)?undefined:id} aria-label={text} aria-pressed={id==='pause'?false:undefined}><span class="glyph" aria-hidden="true">{glyph(text)}</span></button>)}</div><form id="command-form"><div class="input-shell"><input id="operator" name="command" aria-label="Operator command" aria-describedby="command-guide" maxlength="120" autocomplete="off" autocapitalize="none" spellcheck="false"/><div id="input-echo" class="glyph input-echo" aria-hidden="true">{glyph('help / instruction')}</div></div><button type="submit" aria-label="Send command">↵</button></form><p id="command-guide" class="sr-only">Simulated sessions, not live agents. Fictional commands only. Type help for instructions. Arrow up and down recall command history. Focus sessions with their header buttons. All visible text uses Accelerando glyphs, including an encoded mirror of this native input. Native selection and composition work internally, but glyph boundaries do not map to the native caret. No shell or outside connection.</p><div class="response" id="response" role="status" aria-live="polite"><span class="glyph" aria-hidden="true" data-unavailable={glyph("Local vocabulary unavailable. Static glyph transcripts remain. Interactive sessions cannot start.")}></span><span class="semantic"></span></div><noscript><div class="no-script"><p class="glyph" aria-hidden="true">{glyph('This is a static fictional workstation. JavaScript enables local simulation and controls; no real agents or shell are connected.')}</p><p class="semantic">This is a static fictional workstation. JavaScript enables local simulation and controls; no real agents or shell are connected.</p>{model.sessions.map(s=><details><summary aria-label={`${s.name} / read transcript`}><span class="glyph" aria-hidden="true">{glyph(`${s.name} / read transcript`)}</span></summary><p class="glyph" aria-hidden="true">{glyph(s.lines.join(' '))}</p><p class="semantic">{s.lines.join(' ')}</p></details>)}</div></noscript></div>}</article>)}
</section></main><script>import '../components/multiplex.js';</script></body></html>
