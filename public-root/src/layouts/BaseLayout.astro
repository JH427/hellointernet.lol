---
import '../styles/workshop.css';
interface Props { title?: string; description?: string; }
const { title = 'Joshua Harper — hellointernet.lol', description = 'Joshua Harper. Applied AI, tools, and experiments. Inspectable work from a personal workshop.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [{name:'Work',href:'/work/'},{name:'About',href:'/about/'},{name:'Notes',href:'https://wiki.hellointernet.lol/'},{name:'Contact',href:'/contact/'}];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><link rel="icon" href="/favicon.ico" />
<link rel="stylesheet" href="/command-glass.css" /><title>{title}</title>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="workshop-header"><a class="identity" href="/" aria-label="Joshua Harper home"><span class="identity-mark" aria-hidden="true">jh<span>_</span></span><span>hellointernet.lol</span></a>
<nav aria-label="Primary">{nav.map(item => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.name}</a>)}</nav></header>
<main id="main" class="cg-main" tabindex="-1"><slot /></main>
<footer class="workshop-footer"><span>Joshua Harper / a personal workshop</span><div><a href="/resume/">Resume</a><a href="https://github.com/JH427">GitHub ↗</a><a href="https://fullyautomated.enterprises/">FAE / the studio ↗</a></div></footer>
</body></html>
