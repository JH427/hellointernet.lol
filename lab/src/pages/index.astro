---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const experiments = await getCollection('experiments');
const sorted = experiments.sort((a, b) => b.data.id.localeCompare(a.data.id));
---

<BaseLayout title="Lab Experiments">
  <div class="page cg-stack">
    <header class="intro cg-panel">
      <h1>Experiments</h1>
      <p>Half-built tools and prototypes. Expect rough edges. Each entry links to a short note.</p>
    </header>

    <div class="cg-list">
      {sorted.map((item) => (
        <a class="cg-card cg-card-link" href={`/experiments/${item.data.id}`}>
          <div class="cg-meta">
            <span class="id">{item.data.id}</span>
            <span class:list={['cg-status', item.data.status]}>{item.data.status}</span>
            {item.data.timestamp && <span class="timestamp">{item.data.timestamp}</span>}
          </div>
          <div class="title">{item.data.title}</div>
          {item.data.link && (
            <div class="link-hint">Link included</div>
          )}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page,
  .experiment {
    max-width: 820px;
  }

  .title {
    margin-top: 0.6rem;
    font-size: 1.12rem;
  }

  .body {
    margin-top: 1.25rem;
  }

  .back {
    margin-top: 2rem;
    font-family: 'IBM Plex Mono', monospace;
  }
</style>
