---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((experiment) => ({
    params: { id: experiment.data.id },
    props: { experiment },
  }));
}

const { experiment } = Astro.props;
const { Content } = await experiment.render();
---

<BaseLayout title={`${experiment.data.title} | lab.hellointernet.lol`}>
  <article class="experiment cg-text-slab">
    <div class="cg-meta">
      <span class="id">{experiment.data.id}</span>
      <span class:list={['cg-status', experiment.data.status]}>{experiment.data.status}</span>
      {experiment.data.timestamp && <span class="timestamp">{experiment.data.timestamp}</span>}
    </div>
    <h1>{experiment.data.title}</h1>
    <div class="body">
      <Content />
    </div>
    {experiment.data.link && (
      <p class="external">
        <a class="cg-command" href={experiment.data.link} target="_blank" rel="noopener noreferrer">
          <span>$ open experiment</span>
          <span>external</span>
        </a>
      </p>
    )}
    <p class="back"><a href="/">← back to list</a></p>
  </article>
</BaseLayout>

<style>
  .page,
  .experiment {
    max-width: 820px;
  }

  .title {
    margin-top: 0.6rem;
    font-size: 1.12rem;
  }

  .body {
    margin-top: 1.25rem;
  }

  .back {
    margin-top: 2rem;
    font-family: 'IBM Plex Mono', monospace;
  }
</style>
